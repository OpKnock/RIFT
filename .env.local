# RIFT Local Development Environment
# Generated: 2026-09-27T19:30:02+00:00

# Environment
RIFT_ENV=development
RIFT_API_URL=http://localhost:8080
RIFT_WS_URL=ws://localhost:8080

# Persistence (Supabase; unset = in-memory/durable-JSONL fallback)
RIFT_SUPABASE_URL=
RIFT_SUPABASE_KEY=
# JWT mode (verified Supabase JWT; unset = service-token/open-dev mode)
RIFT_SUPABASE_JWT_SECRET=
RIFT_SUPABASE_JWT_AUD=

# Quantum
IBM_QPU_TOKEN=
QUANTUM_BACKEND=statevector-simulator

# Security (canonical names — must match what src/rift reads)
RIFT_API_TOKEN=dev-token-change-in-production
RIFT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production
RIFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Billing (optional, Lemon Squeezy; RIFT_-prefixed canonical)
RIFT_LEMON_SQUEEZY_API_KEY=
RIFT_LEMON_SQUEEZY_STORE_ID=
RIFT_LEMON_SQUEEZY_WEBHOOK_SECRET=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
HEALTH_CHECK_INTERVAL=10

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Development
DEBUG=true
HOT_RELOAD=true
