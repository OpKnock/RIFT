# RIFT Environment Configuration
# Copy this file to .env and customize for your environment
# For local development, use: cp .env.example .env.local

# =============================================================================
# Environment
# =============================================================================
RIFT_ENV=development
RIFT_API_URL=http://localhost:8080
RIFT_WS_URL=ws://localhost:8080

# =============================================================================
# Database (Supabase; unset = in-process archive + durable-JSONL fallback
# under data/. There is no SQLite fallback.)
# =============================================================================
RIFT_SUPABASE_URL=
RIFT_SUPABASE_KEY=
# Verified-JWT identity (production)
RIFT_SUPABASE_JWT_SECRET=

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Quantum Backend
# =============================================================================
RIFT_QPU_TOKEN=
QUANTUM_BACKEND=statevector-simulator

# =============================================================================
# Security
# =============================================================================
# API token for service-to-service auth (set in production)
RIFT_API_TOKEN=
# Verified-JWT identity (CHANGE IN PRODUCTION!)
RIFT_SUPABASE_JWT_SECRET=
RIFT_SUPABASE_JWT_AUD=
# Webhook signature secret (CHANGE IN PRODUCTION!)
RIFT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production
# CORS allow-list (comma-separated, no wildcard). Set to the origin serving
# the Stitch UI; empty = same-origin only.
RIFT_CORS_ORIGINS=

# =============================================================================
# Billing (Optional - Lemon Squeezy)
# =============================================================================
RIFT_LEMON_SQUEEZY_API_KEY=
RIFT_LEMON_SQUEEZY_STORE_ID=
RIFT_LEMON_SQUEEZY_WEBHOOK_SECRET=

# =============================================================================
# Monitoring
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
HEALTH_CHECK_INTERVAL=10

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_OUTPUT=stdout

# =============================================================================
# Development
# =============================================================================
DEBUG=true
HOT_RELOAD=true