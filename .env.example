# RIFT local configuration — copy to .env (never commit real secrets).
# All integrations are optional; the engine runs offline with everything empty.

# --- Supabase persistence (server-side only) ---
# Canonical names. RIFT_ values take precedence over legacy SUPABASE_* fallbacks.
RIFT_SUPABASE_URL=
RIFT_SUPABASE_KEY=
# Legacy fallbacks (still accepted): SUPABASE_URL, SUPABASE_SERVICE_KEY,
# SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY.
# Never expose a service-role key to the browser. See docs/supabase-setup.md.

# --- Service auth gate (optional, recommended when exposing the server) ---
# When set, persistence/checkout/entitlement endpoints require:
#   Authorization: Bearer <token>
RIFT_API_TOKEN=
# When true in front of a real IdP, callers must supply user_id for scoping.
RIFT_REQUIRE_USER_ID=false

# --- Verified JWT identity (production; Supabase Auth) ---
# When set, identity is the verified JWT sub; caller-supplied user_id is ignored.
RIFT_SUPABASE_JWT_SECRET=
# RIFT_JWT_LEEWAY_S=30
# RIFT_SUPABASE_JWT_AUD=
# RIFT_JWT_ISSUER=

# --- In-process rate limiting (defense-in-depth behind edge rules) ---
# RIFT_RATE_LIMIT_ENABLED=false
# RIFT_RATE_LIMIT_DEFAULT_N=120
# RIFT_RATE_LIMIT_DEFAULT_WINDOW_S=60
# RIFT_RATE_LIMIT_EXECUTE_N=20
# RIFT_RATE_LIMIT_EXECUTE_WINDOW_S=60
# RIFT_TRUST_PROXY=false

# --- Quantum (optional) ---
QUANTUM_BACKEND=none

# --- Lemon Squeezy billing (server-side only, all optional) ---
# Leave empty to keep billing disabled. No credentials/products are hard-coded.
RIFT_LEMON_SQUEEZY_API_KEY=
RIFT_LEMON_SQUEEZY_STORE_ID=
RIFT_LEMON_SQUEEZY_WEBHOOK_SECRET=
RIFT_LEMON_SQUEEZY_VARIANT_ID=
# Legacy fallbacks (still accepted): LEMON_SQUEEZY_API_KEY, LEMON_SQUEEZY_STORE_ID,
# LEMON_SQUEEZY_WEBHOOK_SECRET, LEMON_SQUEEZY_VARIANT_ID.
# See docs/billing.md for manual account connection steps.

# --- Computational limits (optional overrides) ---
# RIFT_MAX_POLICY_VARIABLES=16
# RIFT_MAX_PERTURBATIONS=32
# RIFT_MAX_PAYLOAD_BYTES=1000000

# --- FHIR extraction safety ---
# Private-network FHIR targets are refused by default (SSRF protection).
# Enable ONLY for local dev/test against a loopback FHIR fixture.
# RIFT_ALLOW_PRIVATE_FETCH=false
# In production, require HTTPS for all FHIR fetches.
# Set to true ONLY for local dev/test against HTTP fixtures.
# RIFT_ALLOW_HTTP=false
# Comma-separated trusted FHIR hostnames for production (e.g., "fhir.epic.com,fhir.cerner.com").
# When set, only these hosts are permitted. Empty = allow all public hosts (dev/test only).
# RIFT_TRUSTED_FHIR_HOSTS=
