#!/usr/bin/env bash
# RIFT Local Deployment - One-command startup, reset, health, test, demo
# Usage: ./local.sh [start|stop|restart|reset|health|test|demo|logs|shell]

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Config
RIFT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${RIFT_ROOT}/docker-compose.local.yml"
ENV_FILE="${RIFT_ROOT}/.env.local"
PID_FILE="${RIFT_ROOT}/.rift.pid"
LOG_DIR="${RIFT_ROOT}/logs"

# Ensure directories
mkdir -p "${LOG_DIR}"

# Logging
log() { echo -e "${BLUE}[$(date '+%H:%M:%S')]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }

# Check prerequisites
check_prereqs() {
    local missing=()
    command -v docker >/dev/null || missing+=("docker")
    command -v docker-compose >/dev/null || missing+=("docker-compose")
    command -v python3 >/dev/null || missing+=("python3")

    if [ ${#missing[@]} -gt 0 ]; then
        error "Missing prerequisites: ${missing[*]}"
        return 1
    fi
    success "Prerequisites OK"
}

# Generate local env file
gen_env() {
    cat > "${ENV_FILE}" <<EOF
# RIFT Local Development Environment
# Generated: $(date -Iseconds)

# Environment
RIFT_ENV=development
RIFT_API_URL=http://localhost:8080
RIFT_WS_URL=ws://localhost:8080

# Persistence (Supabase; unset = in-memory/durable-JSONL fallback)
RIFT_SUPABASE_URL=${RIFT_SUPABASE_URL:-}
RIFT_SUPABASE_KEY=${RIFT_SUPABASE_KEY:-}
# JWT mode (verified Supabase JWT; unset = service-token/open-dev mode)
RIFT_SUPABASE_JWT_SECRET=${RIFT_SUPABASE_JWT_SECRET:-}
RIFT_SUPABASE_JWT_AUD=${RIFT_SUPABASE_JWT_AUD:-}

# Quantum
IBM_QPU_TOKEN=${IBM_QPU_TOKEN:-}
QUANTUM_BACKEND=statevector-simulator

# Security (canonical names — must match what src/rift reads)
# Service token: LEAVE EMPTY for local development (open dev mode — the
# Stitch UI works out of the box with no login). Set a strong random value
# to switch the API into service-token mode; browsers then exchange it once
# via POST /api/auth/session for an HttpOnly cookie.
RIFT_API_TOKEN=${RIFT_API_TOKEN:-}
RIFT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production
# CORS: explicit allow-list, no wildcards. Set to the origin that serves the
# Stitch UI (its preview/share URL); empty = same-origin only.
RIFT_CORS_ORIGINS=${RIFT_CORS_ORIGINS:-}

# Billing (optional, Lemon Squeezy; RIFT_-prefixed canonical)
RIFT_LEMON_SQUEEZY_API_KEY=${RIFT_LEMON_SQUEEZY_API_KEY:-}
RIFT_LEMON_SQUEEZY_STORE_ID=${RIFT_LEMON_SQUEEZY_STORE_ID:-}
RIFT_LEMON_SQUEEZY_WEBHOOK_SECRET=${RIFT_LEMON_SQUEEZY_WEBHOOK_SECRET:-}

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
HEALTH_CHECK_INTERVAL=10

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Development
DEBUG=true
HOT_RELOAD=true
EOF
    success "Generated ${ENV_FILE}"
}

# Generate docker-compose for local dev
gen_compose() {
    cat > "${COMPOSE_FILE}" <<'EOF'
# RIFT local compose — generated by ./local (GEN=2). Do not edit by hand;
# delete it and re-run start to regenerate. Overrides belong in .env.local.
services:
  rift-api:
    build:
      context: .
      dockerfile: Dockerfile.dev
    ports:
      - "8080:8080"
    environment:
      # Values interpolate from the shell (start() sources .env.local),
      # so operator-supplied Supabase/JWT/token settings actually reach
      # the container; literals below are dev-only defaults.
      - RIFT_ENV=development
      - RIFT_API_TOKEN=${RIFT_API_TOKEN:-dev-token-change-in-production}
      - RIFT_SUPABASE_URL=${RIFT_SUPABASE_URL:-}
      - RIFT_SUPABASE_KEY=${RIFT_SUPABASE_KEY:-}
      - RIFT_SUPABASE_JWT_SECRET=${RIFT_SUPABASE_JWT_SECRET:-}
      - RIFT_SUPABASE_JWT_AUD=${RIFT_SUPABASE_JWT_AUD:-}
      - RIFT_CORS_ORIGINS=${RIFT_CORS_ORIGINS:-}
      - LOG_LEVEL=DEBUG
      - LOG_FORMAT=json
    volumes:
      - ./src:/app/src:ro
      - ./tests:/app/tests:ro
      - ./pyproject.toml:/app/pyproject.toml:ro
      - ./constraints.txt:/app/constraints.txt:ro
      - rift_data:/app/data
    depends_on:
      redis:
        condition: service_healthy
    command: python -m rift.api
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080/api/health || exit 1"]
      interval: 15s
      timeout: 15s
      retries: 30
      start_period: 90s

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  prometheus:
    image: prom/prometheus:latest
    ports:
      - "9090:9090"
    volumes:
      - ./monitoring/prometheus/prometheus.local.yml:/etc/prometheus/prometheus.yml:ro
      - ./monitoring/prometheus/rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=admin
      - GF_INSTALL_PLUGINS=grafana-piechart-panel
    volumes:
      - ./monitoring/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./monitoring/grafana/datasources:/etc/grafana/provisioning/datasources:ro
      - grafana_data:/var/lib/grafana
    depends_on:
      - prometheus
    restart: unless-stopped

volumes:
  rift_data:
  redis_data:
  prometheus_data:
  grafana_data:
EOF
    success "Generated ${COMPOSE_FILE}"
}

# Generate Dockerfile.dev
gen_dockerfile_dev() {
    cat > "${RIFT_ROOT}/Dockerfile.dev" <<'EOF'
FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY constraints.txt .
RUN pip install --no-cache-dir -r constraints.txt

# Install package in dev mode (src/ MUST be copied before pip install -e .,
# otherwise the editable install fails: 'src does not exist or is not a directory')
COPY pyproject.toml .
COPY src/ ./src/
RUN pip install -e .

# Expose API port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Default command (overridden in compose)
CMD ["python", "-m", "rift.api"]
EOF
    success "Generated Dockerfile.dev"
}

# Start services
start() {
    log "Starting RIFT local environment..."

    check_prereqs || return 1

    # Generate configs if missing
    [ -f "${ENV_FILE}" ] || gen_env
    [ -f "${RIFT_ROOT}/Dockerfile.dev" ] || gen_dockerfile_dev
    # The compose file is fully generated: refresh it when it predates the
    # generator (backup first) so stale copies can't pin old behavior.
    if ! grep -q "GEN=2" "${COMPOSE_FILE}" 2>/dev/null; then
        if [ -f "${COMPOSE_FILE}" ]; then
            warn "Regenerating stale docker-compose.local.yml (backup at docker-compose.local.yml.bak)"
            cp "${COMPOSE_FILE}" "${COMPOSE_FILE}.bak"
        fi
        gen_compose
    fi

    # Migrate the old dev-default token (a published placeholder nobody was
    # ever given): empty it so the stack boots into open dev mode instead
    # of a gated mode the browser cannot satisfy. Any other value is left
    # untouched — a real token means the operator wants gating.
    if grep -q '^RIFT_API_TOKEN=dev-token-change-in-production$' "${ENV_FILE}" 2>/dev/null; then
        warn "Clearing stale dev-default RIFT_API_TOKEN (open dev mode; set a real token to gate the API)"
        sed -i 's/^RIFT_API_TOKEN=dev-token-change-in-production$/RIFT_API_TOKEN=/' "${ENV_FILE}"
    fi

    # Load env
    set -a
    source "${ENV_FILE}"
    set +a

    # Say plainly which auth mode the API is about to run in, so a gated
    # stack is never a surprise of 401s in the UI.
    if [ -n "${RIFT_SUPABASE_JWT_SECRET:-}" ]; then
        log "Auth mode: verified-JWT (browser needs a JWT bearer token)"
    elif [ -n "${RIFT_API_TOKEN:-}" ]; then
        warn "Auth mode: service-token (UI needs the token via Settings → API Token)"
    else
        log "Auth mode: open dev (no login needed)"
    fi

    # Start services
    log "Starting Docker services..."
    docker-compose -f "${COMPOSE_FILE}" --env-file "${ENV_FILE}" up -d

    # Wait for health
    log "Waiting for services to be healthy..."
    local retries=30
    while [ $retries -gt 0 ]; do
        if docker-compose -f "${COMPOSE_FILE}" ps --format "table {{.Service}}\t{{.Status}}" | grep -q "unhealthy"; then
            warn "Some services unhealthy, waiting..."
        elif docker-compose -f "${COMPOSE_FILE}" ps --format "table {{.Service}}\t{{.Status}}" | grep -q "starting"; then
            warn "Services starting..."
        else
            break
        fi
        sleep 2
        retries=$((retries - 1))
    done

    # Verify API
    if curl -sf "http://localhost:8080/api/health" >/dev/null; then
        success "RIFT API is healthy at http://localhost:8080"
    else
        error "RIFT API health check failed"
        return 1
    fi

    # Show status
    docker-compose -f "${COMPOSE_FILE}" ps
    success "RIFT local environment started!"
    log "API: http://localhost:8080"
    log "UI: Stitch project 'RIFT Premium - Counterfactual Decision Intelligence' (connects to this API)"
    log "Prometheus: http://localhost:9090"
    log "Grafana: http://localhost:3000 (admin/admin)"
}

# Stop services
stop() {
    log "Stopping RIFT local environment..."
    docker-compose -f "${COMPOSE_FILE}" down
    success "Stopped"
}

# Restart services
restart() {
    stop
    start
}

# Reset to clean state
reset() {
    warn "Resetting RIFT local environment to clean state..."
    stop

    # Remove volumes
    docker-compose -f "${COMPOSE_FILE}" down -v

    # No local database files to remove: persistence is Supabase when
    # configured, otherwise the in-process archive plus durable JSONL
    # ledgers under data/ (kept: audit history must survive a reset).

    # Remove logs
    rm -rf "${LOG_DIR}"
    mkdir -p "${LOG_DIR}"

    # Remove generated configs
    rm -f "${ENV_FILE}"
    rm -f "${COMPOSE_FILE}"

    # Remove Python cache
    find "${RIFT_ROOT}/src" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    find "${RIFT_ROOT}/tests" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

    success "Reset complete. Run './local.sh start' to start fresh."
}

# Health check
health() {
    log "Running health checks..."

    local all_ok=true

    # API health
    if curl -sf "http://localhost:8080/api/health" | jq -e '.status == "ok"' >/dev/null 2>&1; then
        success "API: Healthy"
    else
        error "API: Unhealthy"
        all_ok=false
    fi

    # API meta
    if curl -sf "http://localhost:8080/api/meta" | jq -e '.engine_version' >/dev/null 2>&1; then
        success "API Meta: OK"
    else
        error "API Meta: Failed"
        all_ok=false
    fi

    # Database
    if curl -sf "http://localhost:8080/api/persistence/status" | jq -e '.configured == true' >/dev/null 2>&1; then
        success "Database: Connected"
    else
        warn "Database: Not configured (in-process archive + durable-JSONL fallback)"
    fi

    # Redis
    if docker-compose -f "${COMPOSE_FILE}" exec -T redis redis-cli ping 2>/dev/null | grep -q PONG; then
        success "Redis: Connected"
    else
        error "Redis: Not responding"
        all_ok=false
    fi

    # Prometheus
    if curl -sf "http://localhost:9090/-/healthy" >/dev/null 2>&1; then
        success "Prometheus: Healthy"
    else
        warn "Prometheus: Not responding"
    fi

    # Grafana
    if curl -sf "http://localhost:3000/api/health" >/dev/null 2>&1; then
        success "Grafana: Healthy"
    else
        warn "Grafana: Not responding"
    fi

    # Disk space
    local disk_avail=$(df -h "${RIFT_ROOT}" | awk 'NR==2 {print $4}')
    log "Disk available: ${disk_avail}"

    # Memory
    local mem_avail=$(free -h | awk 'NR==2 {print $7}')
    log "Memory available: ${mem_avail}"

    if [ "$all_ok" = true ]; then
        success "All critical health checks passed!"
        return 0
    else
        error "Some health checks failed"
        return 1
    fi
}

# Run tests
test() {
    log "Running test suite..."

    # Python tests
    log "Running Python tests..."
    if docker-compose -f "${COMPOSE_FILE}" exec -T rift-api python -m pytest tests/ -x -q; then
        success "Python tests passed"
    else
        error "Python tests failed"
        return 1
    fi

    success "All tests passed!"
}

# Run demo
demo() {
    log "Running RIFT demo..."

    # Health check first
    if ! curl -sf "http://localhost:8080/api/health" >/dev/null; then
        error "API not healthy. Run './local.sh start' first."
        return 1
    fi

    # Run demo
    log "Running /api/demo..."
    local demo_result
    demo_result=$(curl -s "http://localhost:8080/api/demo" | jq .)

    echo "${demo_result}" | jq '.guardian, .robust | length, .[0].policy'

    # Twin demo
    log "Running /api/twin/demo?t=13..."
    curl -s "http://localhost:8080/api/twin/demo?t=13" | jq '{day_index, patient_id, risk: .risk.risk, guardian: .guardian.action}'

    # Monitor
    log "Running /api/ops/monitor..."
    curl -s "http://localhost:8080/api/ops/monitor" | jq '{requests_total, failure_rate, guardian_reject_rate}'

    success "Demo complete!"
}

# Show logs
logs() {
    local service="${1:-}"
    if [ -n "${service}" ]; then
        docker-compose -f "${COMPOSE_FILE}" logs -f --tail=100 "${service}"
    else
        docker-compose -f "${COMPOSE_FILE}" logs -f --tail=100
    fi
}

# Shell into container
shell() {
    local service="${1:-rift-api}"
    docker-compose -f "${COMPOSE_FILE}" exec "${service}" /bin/bash
}

# Diagnostics
diag() {
    log "Running full environment diagnostics..."

    echo "=== System Info ==="
    uname -a
    echo "Docker: $(docker --version)"
    echo "Docker Compose: $(docker-compose --version)"
    echo "Python: $(python3 --version)"

    echo ""
    echo "=== Docker Status ==="
    docker-compose -f "${COMPOSE_FILE}" ps

    echo ""
    echo "=== Resource Usage ==="
    docker stats --no-stream --format "table {{.Container}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}\t{{.BlockIO}}"

    echo ""
    echo "=== Disk Usage ==="
    df -h "${RIFT_ROOT}"

    echo ""
    echo "=== Network ==="
    docker network ls | grep rift

    echo ""
    echo "=== Volumes ==="
    docker volume ls | grep rift

    echo ""
    echo "=== API Endpoints ==="
    curl -sf "http://localhost:8080/api/health" | jq .
    curl -sf "http://localhost:8080/api/meta" | jq '.engine_version, .capabilities, .optimizers'

    success "Diagnostics complete"
}

# Init demo data
init_demo() {
    log "Initializing demo data..."

    # The demo data is built into the Python package
    # This just verifies it's accessible
    if curl -sf "http://localhost:8080/api/twin/demo?t=0" >/dev/null; then
        success "Demo data accessible"
    else
        error "Demo data not accessible"
        return 1
    fi

    # Durable JSONL ledgers (data/*.jsonl) are created on first write;
    # there is no SQLite fallback anymore.
    log "Ledger directory: ${RIFT_ROOT}/data"

    success "Demo data initialized"
}

# Main
main() {
    local cmd="${1:-help}"

    case "${cmd}" in
        start)
            start
            ;;
        stop)
            stop
            ;;
        restart)
            restart
            ;;
        reset)
            reset
            ;;
        health)
            health
            ;;
        test)
            test
            ;;
        demo)
            demo
            ;;
        logs)
            logs "${2:-}"
            ;;
        shell)
            shell "${2:-rift-api}"
            ;;
        diag)
            diag
            ;;
        init)
            init_demo
            ;;
        gen-config)
            gen_env
            gen_compose
            gen_dockerfile_dev
            success "Generated all config files"
            ;;
        help|*)
            cat <<EOF
RIFT Local Deployment Manager

Usage: ./local.sh <command> [args]

Commands:
  start       Start all services (API, Redis, Prometheus, Grafana)
  stop        Stop all services
  restart     Restart all services
  reset       Reset to clean state (removes volumes, DB, logs, cache)
  health      Run health checks
  test        Run test suite (Python)
  demo        Run API demo
  logs [svc]  Show logs (optional: service name)
  shell [svc] Open shell in container (default: rift-api)
  diag        Run full environment diagnostics
  init        Initialize demo data
  gen-config  Generate config files (Dockerfile.dev, docker-compose, .env)
  help        Show this help

Examples:
  ./local.sh start          # Start everything
  ./local.sh health         # Check health
  ./local.sh test           # Run tests
  ./local.sh demo           # Run demo
  ./local.sh logs rift-api  # Follow API logs
  ./local.sh shell          # Shell into API container
  ./local.sh diag           # Full diagnostics
  ./local.sh reset          # Clean reset
EOF
            ;;
        esac
    }

main "$@"